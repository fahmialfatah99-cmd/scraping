```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.out
build/
dist/

# Dependencies
.venv/
venv/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Coverage reports
.coverage
coverage/
htmlcov/

# Python specific
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# Distribution / packaging
*.tar.gz
*.whl
*.zip
*.egg

# Environment variables
.env*
!.env.example

# OS generated files
.DS_Store
Thumbs.db
```